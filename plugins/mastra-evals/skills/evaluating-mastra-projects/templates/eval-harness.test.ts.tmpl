import { describe, it, expect } from 'vitest'
import { {{scorerIds}} } from '../src/scorers/{{scorerFile}}'
import {
  createAgentTestRun,
  createTestMessage,
  createToolInvocation,
} from '@mastra/evals/scorers/utils'

// A known-good trace: the expected tool was called. (For a known-bad case, omit
// the toolInvocation or use a wrong toolName and expect score 0.)
const goodTrace = createAgentTestRun({
  inputMessages: [createTestMessage({ content: '{{exampleInput}}', role: 'user' })],
  output: [
    createTestMessage({
      content: '…expected assistant reply…',
      role: 'assistant',
      toolInvocations: [
        createToolInvocation({
          toolCallId: 't1',
          toolName: '{{expectedTool}}',
          args: {},
          result: {},
          state: 'result',
        }),
      ],
    }),
  ],
})

describe('{{scorerId}} (code-based, deterministic)', () => {
  it('scores 1 when the expected behavior is present', async () => {
    const result = await {{scorerId}}.run(goodTrace as any)
    expect(result.score).toBe(1)
  })
})

